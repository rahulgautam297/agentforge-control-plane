# Copy to .env for local (non-Docker) development. In agentforge-infra's
# docker-compose.yml these are supplied as container environment variables
# instead.

# SQLAlchemy URL for the control-plane's own (schema-owning) Postgres role.
DATABASE_URL=postgresql+psycopg://agentforge:agentforge_dev_password@localhost:5432/agentforge

# Password to (idempotently) set on the scoped agentforge_execution role,
# created by the 0002_execution_plane_role migration. Must match what the
# execution-platform service's DATABASE_URL uses.
EXECUTION_ROLE_PASSWORD=execution_dev_password

# Static bearer token accepted by the Phase-1 auth shim (see
# agentforge_control_plane.deps). Every non-/healthz request must send
# `Authorization: Bearer <this value>`.
DEV_BEARER_TOKEN=dev-local-token

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
